# Copy to .env and fill in. Never commit .env.
# Default credentials created by the PostgresML image (local dev only)
DATABASE_URL=postgresql://postgresml:postgresml@db:5432/postgresml

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Chosen in the Phase 0 spike; EMBEDDING_DIM must match the vector(768) column
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

TZ=America/Sao_Paulo

# Pipeline automation (scheduler service)
PIPELINE_SCHEDULE_TIME=06:00
PIPELINE_TZ=America/Sao_Paulo
PIPELINE_SCRAPE_DAYS=2
PIPELINE_EMBED_BATCH_SIZE=32
PIPELINE_RUN_ON_START=false

# LLM cost tracking: USD per million tokens for ANTHROPIC_MODEL (see anthropic.com/pricing).
# Leave at 0 to record tokens only, without a cost estimate.
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
# Previous messages (user + assistant) sent to the LLM as conversation context
HISTORY_MAX_MESSAGES=6

# Reranker (cross-encoder via pgml.rank). Empty = disabled.
# Example: RERANK_MODEL=BAAI/bge-reranker-v2-m3 (downloaded by PostgresML on first use)
RERANK_MODEL=
RERANK_CANDIDATES=20

# Pipeline alerts: stale threshold + Slack/Discord-compatible webhook (empty = no webhook)
PIPELINE_STALE_HOURS=36
PIPELINE_ALERT_WEBHOOK_URL=

# CORS: comma-separated browser origins allowed to call the API ("*" = any)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limit per client IP and minute (0 disables). Chat endpoints call the LLM, so they get less.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_CHAT_PER_MINUTE=15
# Only behind a reverse proxy you control: take the client IP from X-Forwarded-For
RATE_LIMIT_TRUST_PROXY=false

# Answer length limit (the answer says so when it is cut off) and how many chunks of a document
# named by number ("Resolução 525") are sent to the LLM instead of only the top 5
LLM_MAX_TOKENS=2048
PINNED_CHUNKS=12
