# Copy to .env and fill in. Never commit .env.
# Default credentials created by the PostgresML image (local dev only)
DATABASE_URL=postgresql://postgresml:postgresml@db:5432/postgresml

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Chosen in the Phase 0 spike; EMBEDDING_DIM must match the vector(768) column
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

TZ=America/Sao_Paulo

# Pipeline automation (scheduler service)
PIPELINE_SCHEDULE_TIME=06:00
PIPELINE_TZ=America/Sao_Paulo
PIPELINE_SCRAPE_DAYS=2
PIPELINE_EMBED_BATCH_SIZE=32
PIPELINE_RUN_ON_START=false
